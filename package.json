{
    "name": "arflakatool",
    "displayName": "Arflaka Tool",
    "description": "tool to help for coding",
    "version": "0.1.6",
    "publisher": "Arflaka-Limacha",
    "license": "see license in LICENSE.txt",
    "engines": {
        "vscode": "^1.102.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onDidSaveTextDocument",
        "onDidChangeWorkspaceFolders",
        "onDidChangeActiveTextEditor",
        "onDidChangeConfiguration"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "akTool.report",
                "title": "akTool.report (inactif)"
            },
            {
                "command": "akTool.createstruct",
                "title": "akTool.createstruct"
            },
            {
                "command": "akTool.createExample",
                "title": "akTool.createExample"
            },
            {
                "command": "akTool.generateWrokspace",
                "title": "akTool.generateWrokspace"
            },
            {
                "command": "akTool.HexEditor.open",
                "title": "akTool.HexEditor.open"
            }
        ],
        "customEditors": [
            {
                "viewType": "akHexEditor.editor",
                "displayName": "arflaka Hex Editor",
                "selector": [
                    {
                        "filenamePattern": "*.akhe"
                    }
                ]
            }
        ],
        "configuration": {
            "title": "akToo: File Size Status Bar",
            "properties": {
                "fileSizeStatusBar.alignment": {
                    "type": "string",
                    "enum": [
                        "left",
                        "right"
                    ],
                    "default": "right",
                    "description": "Position de l'affichage dans la barre de statut (left ou right)"
                },
                "fileSizeStatusBar.priority": {
                    "type": "number",
                    "default": 100,
                    "description": "prioriter du statut bar plus elever = plus au extreme"
                }
            }
        }
    },
    "scripts": {
        "install": "npm install --save-dev @types/node @vscode/test-cli @vscode/test-electron --legacy-peer-deps",
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "lint": "eslint src",
        "test": "vscode-test",
        "publish": "npm run vscode:prepublish && vsce publish",
        "patch": "npm run vscode:prepublish && vsce publish patch",
        "token": "vsce login Arflaka-Limacha"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/vscode": "^1.138.0",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "eslint": "^10.11.0",
        "typescript": "^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Limacha/arflakatool.git"
    },
    "keywords": [],
    "author": "Arflaka-Limacha",
    "bugs": {
        "url": "https://github.com/Limacha/arflakatool/issues"
    },
    "homepage": "https://github.com/Limacha/arflakatool#readme",
    "dependencies": {
        "tsc": "^2.0.4"
    }
}